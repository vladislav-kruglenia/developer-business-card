{
  "name": "developer-business-card",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "GraphQL-визитка разработчика на NestJS, Prisma и PostgreSQL",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:container": "prisma migrate deploy && prisma db seed && node dist/main.js",
    "start:local": "prisma migrate deploy && prisma db seed && nest start --watch",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.2",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.5.0",
    "graphql": "^16.11.0",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.19.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
